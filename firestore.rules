rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CAMBIAR por el mismo email que ADMIN_EMAIL en src/config/site.js
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'matiasgarbarino19@gmail.com';
    }
    match /delmana_consultas/{id} {
      allow create: if request.resource.data.keys().hasOnly(['fecha','nombre','empresa','telefono','email','mensaje','leido'])
        && request.resource.data.leido == false
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 100
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }
  }
}
